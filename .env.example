MT5_MODE=live
MT5_WAIT_SECONDS=600

# Broker account number (not your email), exact server name, and password.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# History limit applied to MT5 at startup
MT5_MAX_BARS=100000000

MT5_IMAGE=mt5scraper:local
MT5_DESKTOP_PORT=6080

DASHBOARD_IMAGE=mt5scraper-dashboard:local
DASHBOARD_PORT=8080
# Optional dashboard HTTP Basic auth; use HTTPS or an SSH tunnel for remote access.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Per-container resource caps; memory plus swap equals memory (no extra swap).
MT5_CPU_LIMIT=4.0
MT5_MEMORY_LIMIT=4g
MT5_PIDS_LIMIT=512
DASHBOARD_CPU_LIMIT=0.25
DASHBOARD_MEMORY_LIMIT=256m
DASHBOARD_PIDS_LIMIT=64

# Live collector; leaving symbols blank chooses 20 FX + up to 20 broker-listed metals.
LIVE_POLL_SECONDS=1
LIVE_CANDLE_SECONDS=5
LIVE_MAX_BARS=1000
LIVE_SEED_BARS=200
LIVE_SYMBOLS=
# Subtracted from broker tick/candle timestamps before storage. Keep 0 unless verified.
MT5_TIME_OFFSET_SECONDS=0
